/* Clean Light Theme for UofT Course Dashboard - High Readability */

/* Main Application */
QMainWindow {
    background-color: #ffffff;
    color: #000000;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 9pt;
}

/* Tab Widget */
QTabWidget::pane {
    border: 2px solid #cccccc;
    background-color: #ffffff;
    border-radius: 4px;
}

QTabWidget::tab-bar {
    alignment: left;
}

QTabBar::tab {
    background-color: #f5f5f5;
    border: 1px solid #cccccc;
    padding: 12px 24px;
    margin-right: 2px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    min-width: 120px;
    color: #000000;
    font-weight: normal;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    border-bottom-color: #ffffff;
    font-weight: bold;
    color: #000000;
}

QTabBar::tab:hover {
    background-color: #e8f4f8;
    color: #000000;
}

/* Buttons - High Contrast */
QPushButton {
    background-color: #0066cc;
    color: #ffffff;
    border: 2px solid #0066cc;
    padding: 10px 20px;
    border-radius: 4px;
    font-weight: bold;
    font-size: 9pt;
    min-width: 100px;
}

QPushButton:hover {
    background-color: #0052a3;
    border-color: #0052a3;
    color: #ffffff;
}

QPushButton:pressed {
    background-color: #004085;
    border-color: #004085;
    color: #ffffff;
}

QPushButton:disabled {
    background-color: #e6e6e6;
    border-color: #cccccc;
    color: #666666;
}

/* Secondary buttons */
QPushButton[class="secondary"] {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #666666;
}

QPushButton[class="secondary"]:hover {
    background-color: #f0f0f0;
    border-color: #333333;
    color: #000000;
}

/* Success buttons */
QPushButton[class="success"] {
    background-color: #006600;
    color: #ffffff;
    border: 2px solid #006600;
}

QPushButton[class="success"]:hover {
    background-color: #004d00;
    border-color: #004d00;
    color: #ffffff;
}

/* Danger buttons */
QPushButton[class="danger"] {
    background-color: #cc0000;
    color: #ffffff;
    border: 2px solid #cc0000;
}

QPushButton[class="danger"]:hover {
    background-color: #990000;
    border-color: #990000;
    color: #ffffff;
}

/* Frames and Panels */
QFrame {
    background-color: #ffffff;
    border: 2px solid #cccccc;
    border-radius: 4px;
}

QFrame[frameShape="4"] { /* StyledPanel */
    padding: 15px;
    background-color: #ffffff;
}

/* Labels - High Readability */
QLabel {
    color: #000000;
    font-size: 9pt;
    background-color: transparent;
}

QLabel[class="title"] {
    font-size: 18pt;
    font-weight: bold;
    color: #000000;
    background-color: transparent;
}

QLabel[class="subtitle"] {
    font-size: 10pt;
    color: #333333;
    background-color: transparent;
}

QLabel[class="header"] {
    font-size: 12pt;
    font-weight: bold;
    color: #000000;
    padding: 8px 0px;
    background-color: transparent;
}

/* Input Fields - High Contrast */
QLineEdit {
    border: 2px solid #666666;
    border-radius: 4px;
    padding: 10px;
    background-color: #ffffff;
    color: #000000;
    font-size: 9pt;
    selection-background-color: #0066cc;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border-color: #0066cc;
    outline: none;
}

QTextEdit {
    border: 2px solid #666666;
    border-radius: 4px;
    background-color: #ffffff;
    color: #000000;
    font-size: 9pt;
    selection-background-color: #0066cc;
    selection-color: #ffffff;
}

QTextEdit:focus {
    border-color: #0066cc;
}

/* ComboBox - High Readability */
QComboBox {
    border: 2px solid #666666;
    border-radius: 4px;
    padding: 10px;
    background-color: #ffffff;
    color: #000000;
    font-size: 9pt;
    min-width: 150px;
}

QComboBox:focus {
    border-color: #0066cc;
}

QComboBox::drop-down {
    border: none;
    width: 30px;
    background-color: #f0f0f0;
}

QComboBox::down-arrow {
    width: 12px;
    height: 12px;
    background-color: #000000;
}

/* Table Widget - High Contrast */
QTableWidget {
    gridline-color: #cccccc;
    background-color: #ffffff;
    alternate-background-color: #f8f8f8;
    selection-background-color: #0066cc;
    selection-color: #ffffff;
    border: 2px solid #666666;
    border-radius: 4px;
    color: #000000;
    font-size: 9pt;
}

QTableWidget::item {
    padding: 12px;
    border: none;
    color: #000000;
}

QTableWidget::item:selected {
    background-color: #0066cc;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #e0e0e0;
    border: 1px solid #666666;
    padding: 12px;
    font-weight: bold;
    color: #000000;
    font-size: 9pt;
}

/* Progress Bar - High Contrast */
QProgressBar {
    border: 2px solid #666666;
    border-radius: 4px;
    text-align: center;
    background-color: #ffffff;
    color: #000000;
    font-size: 9pt;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #0066cc;
    border-radius: 2px;
}

/* Menu Bar - High Readability */
QMenuBar {
    background-color: #ffffff;
    border-bottom: 2px solid #cccccc;
    color: #000000;
    font-size: 9pt;
}

QMenuBar::item {
    background-color: transparent;
    padding: 10px 15px;
    color: #000000;
}

QMenuBar::item:selected {
    background-color: #e0e0e0;
    color: #000000;
    border-radius: 4px;
}

QMenu {
    background-color: #ffffff;
    border: 2px solid #666666;
    border-radius: 4px;
    color: #000000;
    font-size: 9pt;
}

QMenu::item {
    padding: 10px 20px;
    color: #000000;
}

QMenu::item:selected {
    background-color: #0066cc;
    color: #ffffff;
}

/* Status Bar - High Contrast */
QStatusBar {
    background-color: #f0f0f0;
    border-top: 2px solid #cccccc;
    padding: 8px;
    color: #000000;
    font-size: 9pt;
}

/* Scrollbars - High Contrast */
QScrollBar:vertical {
    border: 1px solid #666666;
    background-color: #f0f0f0;
    width: 16px;
    border-radius: 4px;
}

QScrollBar::handle:vertical {
    background-color: #666666;
    border-radius: 4px;
    min-height: 30px;
}

QScrollBar::handle:vertical:hover {
    background-color: #333333;
}

QScrollBar:horizontal {
    border: 1px solid #666666;
    background-color: #f0f0f0;
    height: 16px;
    border-radius: 4px;
}

QScrollBar::handle:horizontal {
    background-color: #666666;
    border-radius: 4px;
    min-width: 30px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #333333;
}

/* Tooltips - High Readability */
QToolTip {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 9pt;
}

/* Splitter - High Contrast */
QSplitter::handle {
    background-color: #cccccc;
}

QSplitter::handle:horizontal {
    width: 5px;
}

QSplitter::handle:vertical {
    height: 5px;
}

QSplitter::handle:hover {
    background-color: #0066cc;
}