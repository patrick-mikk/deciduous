        "selector": "JSXOpeningElement[name.name='AuthCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|subtitle|children|footer|width|key|ref|className|style|children)$/]",
        "message": "<AuthCard> doesn't accept that prop. Declared props: title, subtitle, children, footer, width."
