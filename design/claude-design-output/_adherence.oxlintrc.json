{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/account/**",
              "components/courses/**",
              "components/data/**",
              "components/display/**",
              "components/feedback/**",
              "components/forms/**",
              "components/layout/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/plan/**",
              "components/programs/**",
              "components/progress/**",
              "components/requirements/**",
              "components/timetable/**",
              "ui_kits/deciduous/**",
              "ui_kits/deciduous/screens/**",
              "ui_kits/planner/**",
              "ui_kits/planner/screens/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Source Serif 4|IBM Plex Mono))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Source Serif 4, IBM Plex Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='AccordionItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|header|badge|content|key|ref|className|style|children)$/]",
        "message": "<AccordionItem> doesn't accept that prop. Declared props: id, header, badge, content."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:active|onNavigate|navItems|progress|children|defaultTheme|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: active, onNavigate, navItems, progress, children, defaultTheme."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute[name.name='defaultTheme'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<AppShell> defaultTheme must be one of 'light' | 'dark'."
      },
